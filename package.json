{
  "name": "playwright-web-tests",
  "version": "1.0.0",
  "description": "E2E test automation with Playwright + POM + Allure",
  "scripts": {
    "test":                   "playwright test",
    "test:headed":            "playwright test --headed",
    "test:headless":          "playwright test --headless",
    "test:chrome":            "playwright test --project=chromium",
    "test:firefox":           "playwright test --project=firefox",
    "test:webkit":            "playwright test --project=webkit",
    "test:login":             "playwright test tests/login.spec.ts",
    "test:inventory":         "playwright test tests/inventory.spec.ts",
    "test:order":             "playwright test tests/order.spec.ts",
    "test:chrome:headed":     "playwright test --project=chromium --headed",
    "test:debug":             "playwright test --debug",
    "test:ui":                "playwright test --ui",
    "allure:clean":           "rimraf allure-results allure-report",
    "allure:generate":        "allure generate allure-results --clean -o allure-report",
    "allure:open":            "allure open allure-report",
    "allure:serve":           "allure serve allure-results",
    "report:html":            "playwright show-report playwright-report",
    "ci":                     "playwright test --reporter=allure-playwright,list"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "allure-playwright": "^3.0.0",
    "allure-js-commons": "^3.0.0",
    "rimraf": "^5.0.5",
    "winston": "^3.13.0"
  }
}
